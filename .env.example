# --- Envoi des demandes de contact (Resend) ---------------------------------
# Sans ces variables, le formulaire répond correctement mais le message n'est
# QUE journalisé côté serveur : il n'est pas transmis. À configurer avant la
# mise en ligne (voir app/api/contact/route.ts).
RESEND_API_KEY=
CONTACT_FROM_EMAIL="GL TECH CONCEPT <site@votre-domaine.be>"
CONTACT_TO_EMAIL=

# --- Espace d'administration (Supabase) -------------------------------------
# Projet Supabase > Settings > API. La clé « anon » est publique : la sécurité
# repose sur les politiques RLS et sur Supabase Auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
